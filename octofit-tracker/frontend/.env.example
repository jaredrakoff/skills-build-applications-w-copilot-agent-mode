# Copy this file to `.env.local` and set the value for your environment.
#
# VITE_CODESPACE_NAME is the GitHub Codespaces name used to build the API
# base URL: https://${VITE_CODESPACE_NAME}-8000.app.github.dev/api/...
# If it is left unset, the app falls back to http://localhost:8000.
VITE_CODESPACE_NAME=
